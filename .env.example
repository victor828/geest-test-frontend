# URL del backend (se hornea en el build de Vite)
VITE_API_BASE_URL=https://geest.veom.lat

# Puerto expuesto en el host para el contenedor dev (vite)
DEV_PORT=5173

# Puerto expuesto en el host para el contenedor prod (nginx)
PROD_PORT=8080

# Puerto interno donde nginx escucha dentro del contenedor
PORT=8080
